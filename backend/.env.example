# Plantilla de variables de entorno.
# Copiar a .env y completar con los valores reales. El .env NO se versiona.

# --- Base de datos MySQL ---
DB_URL=jdbc:mysql://mysql:3306/inventioryApp?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=

# --- Seguridad: clave para firmar los JWT (Base64, minimo 256 bits) ---
JWT_SECRET=

# --- Servidor SMTP para envio de mails ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- URLs publicas ---
FRONTEND_BASE_URL=https://inventiory.example.com
CORS_ALLOWED_ORIGINS=https://inventiory.example.com,http://localhost:3000
